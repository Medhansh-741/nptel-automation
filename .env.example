# =============================================================
# NPTEL Course Automation Pipeline — environment template
# Copy this file to `.env` and fill in YOUR device values.
# `.env` is git-ignored; NEVER commit it.
# =============================================================

# --- Ollama (local OCR) ---
# Base URL of the Ollama server
OLLAMA_HOST=http://127.0.0.1:11434
# Name of the tuned OCR model (create it once via: ollama create glm-ocr-tuned -f Modelfile)
OLLAMA_MODEL=glm-ocr-tuned
# Keep the model resident in VRAM between calls (-1 = forever, faster)
OLLAMA_KEEP_ALIVE=-1

# --- OCR model sampling parameters ---
GLM_OCR_CTX=16384
GLM_OCR_PREDICT=8192

# --- Database ---
# Path to the SQLite DB, relative to repo root
DB_PATH=db/answers.db

# --- Browser automation (Playwright MCP) ---
# Full path to the persistent Chrome profile used by the Playwright MCP server.
# Your live NPTEL session (cookies) lives here.
BROWSER_PROFILE_DIR=C:\PATH\TO\YOUR\PROFILE
# Full path to your opencode config that registers the Playwright MCP server
MCP_CONFIG_PATH=C:\Users\YOU\.config\opencode\opencode.jsonc

# --- Runtime ---
# Python executable used by scripts/ (must have nothing beyond stdlib — only sqlite3/urllib used)
PYTHON_BIN=python

# --- NPTEL course ---
# Course code discovered at runtime from the outline — only here as a fallback hint.
# e.g. noc26_cs000 (replace with your course)
NPTEL_COURSE_ID=
